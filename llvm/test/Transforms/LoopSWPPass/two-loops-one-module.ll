; CHECK-NEXT:    [[LD_X1]] = tail call <64 x float> @llvm.tpc.ld.tnsr.v64f32.i1(<5 x i32> zeroinitializer, i8 0, i32 0, <64 x float> [[X1]], i1 false, i1 false)
