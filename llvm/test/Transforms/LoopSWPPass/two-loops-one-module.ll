  %x1.init = tail call <64 x float> @llvm.tpc.ld.tnsr.v64f32.i1(<5 x i32> zeroinitializer, i8 1, i32 0, <64 x float> zeroinitializer, i1 false, i1 false)
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %x0 = phi <64 x float> [ %x0.init, %entry ], [ %ld.x0, %loop ]
  %x1 = phi <64 x float> [ %x1.init, %entry ], [ %ld.x1, %loop ]
  %ld.a = tail call <64 x float> @llvm.tpc.ld.tnsr.v64f32.i1(<5 x i32> zeroinitializer, i8 0, i32 0, <64 x float> zeroinitializer, i1 false, i1 false)
  %sum.a = fadd <64 x float> %ld.a, zeroinitializer
  tail call void @llvm.tpc.st.tnsr.v64f32(<5 x i32> zeroinitializer, i8 0, <64 x float> %sum.a, i32 0, i1 false, i1 false)
  %ld.x0 = tail call <64 x float> @llvm.tpc.ld.tnsr.v64f32.i1(<5 x i32> zeroinitializer, i8 0, i32 0, <64 x float> %x0, i1 false, i1 false)
