; CHECK-NEXT:    [[X1_INIT:%.*]] = tail call <64 x float> @llvm.tpc.ld.tnsr.v64f32.i1(<5 x i32> zeroinitializer, i8 1, i32 0, <64 x float> zeroinitializer, i1 false, i1 false)
