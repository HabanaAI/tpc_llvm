; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -passes=tpc-licm -S | FileCheck %s

; tpc-licm moves a lookup with the instructions that compute its index from
; llvm.read_register. It must leave them in place when they also use a value
; that is not available where they would go: hoisting them made the IR invalid
; ("Instruction does not dominate all uses!"). From C, a lookup indexed by a
; v_lane_id_32 register variable plus the loop counter did this.

target triple = "tpc"

define void @index_uses_iv(i32 %n) {
; CHECK-LABEL: define void @index_uses_iv(
; CHECK-SAME: i32 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[LANE:%.*]] = call <64 x i32> @llvm.read_register.v64i32(metadata [[META0:![0-9]+]])
; CHECK-NEXT:    [[I_INS:%.*]] = insertelement <64 x i32> poison, i32 [[I]], i64 0
; CHECK-NEXT:    [[I_SPLAT:%.*]] = shufflevector <64 x i32> [[I_INS]], <64 x i32> poison, <64 x i32> zeroinitializer
; CHECK-NEXT:    [[IDX:%.*]] = add <64 x i32> [[LANE]], [[I_SPLAT]]
; CHECK-NEXT:    [[R:%.*]] = call <64 x float> @llvm.tpc.lookup.1c.v64f32.v64i32(<64 x i32> [[IDX]], i32 282, i32 0, <64 x float> undef, i1 true, i1 false)
; CHECK-NEXT:    call void @llvm.tpc.st.tnsr.v64f32(<5 x i32> zeroinitializer, i8 0, <64 x float> [[R]], i32 0, i1 true, i1 false)
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i32 [[I]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %lane = call <64 x i32> @llvm.read_register.v64i32(metadata !0)
  %i.ins = insertelement <64 x i32> poison, i32 %i, i64 0
  %i.splat = shufflevector <64 x i32> %i.ins, <64 x i32> poison, <64 x i32> zeroinitializer
  %idx = add <64 x i32> %lane, %i.splat
  %r = call <64 x float> @llvm.tpc.lookup.1c.v64f32.v64i32(<64 x i32> %idx, i32 282, i32 0, <64 x float> undef, i1 true, i1 false)
  call void @llvm.tpc.st.tnsr.v64f32(<5 x i32> zeroinitializer, i8 0, <64 x float> %r, i32 0, i1 true, i1 false)
  %i.next = add nuw nsw i32 %i, 1
  %cmp = icmp slt i32 %i.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

; An argument is available before the loop, so the chain moves.
define void @index_uses_argument(i32 %n, <64 x i32> %off) {
; CHECK-LABEL: define void @index_uses_argument(
; CHECK-SAME: i32 [[N:%.*]], <64 x i32> [[OFF:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[LANE:%.*]] = call <64 x i32> @llvm.read_register.v64i32(metadata [[META0]])
; CHECK-NEXT:    [[IDX:%.*]] = add <64 x i32> [[LANE]], [[OFF]]
; CHECK-NEXT:    [[R:%.*]] = call <64 x float> @llvm.tpc.lookup.1c.v64f32.v64i32(<64 x i32> [[IDX]], i32 282, i32 0, <64 x float> undef, i1 true, i1 false)
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    call void @llvm.tpc.st.tnsr.v64f32(<5 x i32> zeroinitializer, i8 0, <64 x float> [[R]], i32 0, i1 true, i1 false)
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i32 [[I]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %lane = call <64 x i32> @llvm.read_register.v64i32(metadata !0)
  %idx = add <64 x i32> %lane, %off
  %r = call <64 x float> @llvm.tpc.lookup.1c.v64f32.v64i32(<64 x i32> %idx, i32 282, i32 0, <64 x float> undef, i1 true, i1 false)
  call void @llvm.tpc.st.tnsr.v64f32(<5 x i32> zeroinitializer, i8 0, <64 x float> %r, i32 0, i1 true, i1 false)
  %i.next = add nuw nsw i32 %i, 1
  %cmp = icmp slt i32 %i.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

; The inner loop's chain would go to the end of the outer header, but %off is
; computed after it, in %outer.body.
define void @index_uses_outer_body_value(i32 %n, i32 %m) {
; CHECK-LABEL: define void @index_uses_outer_body_value(
; CHECK-SAME: i32 [[N:%.*]], i32 [[M:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[OUTER:.*]]
; CHECK:       [[OUTER]]:
; CHECK-NEXT:    [[J:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[J_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
; CHECK-NEXT:    br label %[[OUTER_BODY:.*]]
; CHECK:       [[OUTER_BODY]]:
; CHECK-NEXT:    [[J_INS:%.*]] = insertelement <64 x i32> poison, i32 [[J]], i64 0
; CHECK-NEXT:    [[OFF:%.*]] = shufflevector <64 x i32> [[J_INS]], <64 x i32> poison, <64 x i32> zeroinitializer
; CHECK-NEXT:    br label %[[INNER:.*]]
; CHECK:       [[INNER]]:
; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[OUTER_BODY]] ], [ [[I_NEXT:%.*]], %[[INNER]] ]
; CHECK-NEXT:    [[LANE:%.*]] = call <64 x i32> @llvm.read_register.v64i32(metadata [[META0]])
; CHECK-NEXT:    [[IDX:%.*]] = add <64 x i32> [[LANE]], [[OFF]]
; CHECK-NEXT:    [[R:%.*]] = call <64 x float> @llvm.tpc.lookup.1c.v64f32.v64i32(<64 x i32> [[IDX]], i32 282, i32 0, <64 x float> undef, i1 true, i1 false)
; CHECK-NEXT:    call void @llvm.tpc.st.tnsr.v64f32(<5 x i32> zeroinitializer, i8 0, <64 x float> [[R]], i32 0, i1 true, i1 false)
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i32 [[I]], 1
; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[INNER]], label %[[OUTER_LATCH]]
; CHECK:       [[OUTER_LATCH]]:
; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i32 [[J]], 1
; CHECK-NEXT:    [[CMP_J:%.*]] = icmp slt i32 [[J_NEXT]], [[M]]
; CHECK-NEXT:    br i1 [[CMP_J]], label %[[OUTER]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %outer

outer:
  %j = phi i32 [ 0, %entry ], [ %j.next, %outer.latch ]
  br label %outer.body

outer.body:
  %j.ins = insertelement <64 x i32> poison, i32 %j, i64 0
  %off = shufflevector <64 x i32> %j.ins, <64 x i32> poison, <64 x i32> zeroinitializer
  br label %inner

inner:
  %i = phi i32 [ 0, %outer.body ], [ %i.next, %inner ]
  %lane = call <64 x i32> @llvm.read_register.v64i32(metadata !0)
  %idx = add <64 x i32> %lane, %off
  %r = call <64 x float> @llvm.tpc.lookup.1c.v64f32.v64i32(<64 x i32> %idx, i32 282, i32 0, <64 x float> undef, i1 true, i1 false)
  call void @llvm.tpc.st.tnsr.v64f32(<5 x i32> zeroinitializer, i8 0, <64 x float> %r, i32 0, i1 true, i1 false)
  %i.next = add nuw nsw i32 %i, 1
  %cmp = icmp slt i32 %i.next, %n
  br i1 %cmp, label %inner, label %outer.latch

outer.latch:
  %j.next = add nuw nsw i32 %j, 1
  %cmp.j = icmp slt i32 %j.next, %m
  br i1 %cmp.j, label %outer, label %exit

exit:
  ret void
}

declare <64 x i32> @llvm.read_register.v64i32(metadata)
declare <64 x float> @llvm.tpc.lookup.1c.v64f32.v64i32(<64 x i32>, i32, i32, <64 x float>, i1, i1)
declare void @llvm.tpc.st.tnsr.v64f32(<5 x i32>, i8, <64 x float>, i32, i1, i1)

!0 = !{!"v_lane_id_32"}
;.
; CHECK: [[META0]] = !{!"v_lane_id_32"}
;.
