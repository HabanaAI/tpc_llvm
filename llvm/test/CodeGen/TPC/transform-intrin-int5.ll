; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -passes=tpc-trans-intr -tpc-trans-intr-int5 -S | FileCheck %s

; With -tpc-trans-intr-int5, a masked int5 op becomes one extractelement, op
; and insertelement per lane in the dimmask. The insertelements must form one
; chain that starts from the income, the value the lanes outside the mask
; keep. Before, each lane inserted into the int5 operand, so only the last
; lane's update was kept and the income was ignored.

target triple = "tpc"

define <5 x i32> @add_two_lanes(<5 x i32> %c, i32 %k) {
; CHECK-LABEL: define <5 x i32> @add_two_lanes(
; CHECK-SAME: <5 x i32> [[C:%.*]], i32 [[K:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = extractelement <5 x i32> [[C]], i32 0
; CHECK-NEXT:    [[TMP2:%.*]] = add nsw i32 [[TMP1]], [[K]]
; CHECK-NEXT:    [[TMP3:%.*]] = insertelement <5 x i32> [[C]], i32 [[TMP2]], i32 0
; CHECK-NEXT:    [[TMP4:%.*]] = extractelement <5 x i32> [[C]], i32 1
; CHECK-NEXT:    [[TMP5:%.*]] = add nsw i32 [[TMP4]], [[K]]
; CHECK-NEXT:    [[TMP6:%.*]] = insertelement <5 x i32> [[TMP3]], i32 [[TMP5]], i32 1
; CHECK-NEXT:    ret <5 x i32> [[TMP6]]
;
  %r = call <5 x i32> @llvm.tpc.add.mask.v5i32.i32(<5 x i32> %c, i32 %k, i32 3, i8 2, i32 0, <5 x i32> %c, i1 true, i1 false)
  ret <5 x i32> %r
}

define <5 x i32> @add_other_income(<5 x i32> %c, i32 %k, <5 x i32> %e) {
; CHECK-LABEL: define <5 x i32> @add_other_income(
; CHECK-SAME: <5 x i32> [[C:%.*]], i32 [[K:%.*]], <5 x i32> [[E:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = extractelement <5 x i32> [[C]], i32 0
; CHECK-NEXT:    [[TMP2:%.*]] = add nsw i32 [[TMP1]], [[K]]
; CHECK-NEXT:    [[TMP3:%.*]] = insertelement <5 x i32> [[E]], i32 [[TMP2]], i32 0
; CHECK-NEXT:    [[TMP4:%.*]] = extractelement <5 x i32> [[C]], i32 2
; CHECK-NEXT:    [[TMP5:%.*]] = add nsw i32 [[TMP4]], [[K]]
; CHECK-NEXT:    [[TMP6:%.*]] = insertelement <5 x i32> [[TMP3]], i32 [[TMP5]], i32 2
; CHECK-NEXT:    ret <5 x i32> [[TMP6]]
;
  %r = call <5 x i32> @llvm.tpc.add.mask.v5i32.i32(<5 x i32> %c, i32 %k, i32 5, i8 2, i32 0, <5 x i32> %e, i1 true, i1 false)
  ret <5 x i32> %r
}

; clang emits i_i32_sub(k, c, ...) with a splat of k as the first operand. For
; add the pass swaps the operands; k - c cannot be swapped, so it is left
; alone. Before, it became c - k.
define <5 x i32> @sub_splat_first(<5 x i32> %c, i32 %k) {
; CHECK-LABEL: define <5 x i32> @sub_splat_first(
; CHECK-SAME: <5 x i32> [[C:%.*]], i32 [[K:%.*]]) {
; CHECK-NEXT:    [[INS:%.*]] = insertelement <5 x i32> poison, i32 [[K]], i64 0
; CHECK-NEXT:    [[SPLAT:%.*]] = shufflevector <5 x i32> [[INS]], <5 x i32> poison, <5 x i32> zeroinitializer
; CHECK-NEXT:    [[R:%.*]] = call <5 x i32> @llvm.tpc.sub.mask.v5i32.v5i32(<5 x i32> [[SPLAT]], <5 x i32> [[C]], i32 3, i8 2, i32 0, <5 x i32> [[C]], i1 true, i1 false)
; CHECK-NEXT:    ret <5 x i32> [[R]]
;
  %ins = insertelement <5 x i32> poison, i32 %k, i64 0
  %splat = shufflevector <5 x i32> %ins, <5 x i32> poison, <5 x i32> zeroinitializer
  %r = call <5 x i32> @llvm.tpc.sub.mask.v5i32.v5i32(<5 x i32> %splat, <5 x i32> %c, i32 3, i8 2, i32 0, <5 x i32> %c, i1 true, i1 false)
  ret <5 x i32> %r
}

declare <5 x i32> @llvm.tpc.add.mask.v5i32.i32(<5 x i32>, i32, i32, i8, i32, <5 x i32>, i1, i1)
declare <5 x i32> @llvm.tpc.sub.mask.v5i32.v5i32(<5 x i32>, <5 x i32>, i32, i8, i32, <5 x i32>, i1, i1)
